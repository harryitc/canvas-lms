# ====== Cau hinh tool LTI Lucky Wheel ======

# Cong tool chay
PORT=4000

# URL cong khai cua chinh tool nay (Canvas se goi vao day).
# Khi dev local, dung ngrok de co HTTPS, vi du: https://abcd-1234.ngrok-free.app
# Phai trung voi URL ma ban dang ky trong Developer Key.
TOOL_URL=http://localhost:4000

# ====== Cau hinh phia Canvas (Platform LTI 1.3) ======

# Issuer cua Canvas. Mac dinh ban Instructure-hosted la https://canvas.instructure.com
# Voi Canvas open-source self-host, kiem tra claim "iss" trong id_token neu xac thuc loi.
CANVAS_ISSUER=https://canvas.instructure.com

# Endpoint OIDC authorize cua Canvas (noi tool redirect den o buoc 2)
CANVAS_AUTH_URL=https://canvas.instructure.com/api/lti/authorize_redirect

# URL public JWKS cua Canvas (de tool lay khoa cong khai verify id_token)
CANVAS_JWKS_URL=https://canvas.instructure.com/api/lti/security/jwks

# Token endpoint (chi can neu goi cac dich vu LTI Advantage - vi du nay khong dung)
CANVAS_TOKEN_URL=https://canvas.instructure.com/login/oauth2/token

# Client ID lay tu Developer Key sau khi tao (dien sau khi dang ky, roi restart tool)
CLIENT_ID=

# Deployment ID (tuy chon - de trong neu khong kiem tra chat)
DEPLOYMENT_ID=
